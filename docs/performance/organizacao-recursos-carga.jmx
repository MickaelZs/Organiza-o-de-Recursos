          <elementProp name="end" elementType="Argument"><stringProp name="Argument.name">end</stringProp><stringProp name="Argument.value">${__P(end,2026-12-01T11:00:00-03:00)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="overlapStart" elementType="Argument"><stringProp name="Argument.name">overlapStart</stringProp><stringProp name="Argument.value">${__P(overlapStart,2026-12-02T10:30:00-03:00)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
          <elementProp name="overlapEnd" elementType="Argument"><stringProp name="Argument.name">overlapEnd</stringProp><stringProp name="Argument.value">${__P(overlapEnd,2026-12-02T12:30:00-03:00)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp>
